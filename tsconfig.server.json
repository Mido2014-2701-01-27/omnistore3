{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-server",
    "strict": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts", "src/data.ts", "src/types.ts"]
}
